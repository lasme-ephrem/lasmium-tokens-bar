{
  "name": "lasmium-tokens-hub",
  "version": "0.6.14",
  "private": true,
  "description": "Lasmium TOKENS-HUB — suivi local des abonnements, quotas et crédits IA pour Windows",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.cjs",
    "verify": "node scripts/check-syntax.cjs",
    "lint": "node scripts/lint.cjs",
    "lint:fix": "node scripts/lint.cjs --fix",
    "doctor": "node scripts/doctor.cjs",
    "test:desktop": "node scripts/smoke.cjs",
    "test:resources:desktop": "node scripts/smoke-resource-status.cjs",
    "package": "node scripts/package.cjs",
    "preview": "node scripts/preview.cjs",
    "update:portable": "node scripts/update-portable.cjs",
    "test:claude:desktop": "node scripts/smoke-claude.cjs",
    "package:release": "node scripts/package.cjs --release",
    "package:installer": "node scripts/build-installer.cjs",
    "release:artifacts": "node scripts/release-artifacts.cjs",
    "release:verify": "node scripts/verify-release-archive.cjs",
    "verify:connections": "node scripts/verify-connections.cjs",
    "connectors:key": "node scripts/generate-connector-pack-key.cjs",
    "connectors:sign": "node scripts/sign-connector-pack.cjs",
    "connectors:canary": "node scripts/connector-canary.cjs",
    "connectors:canary:live": "node scripts/connector-canary.cjs --live",
    "updater:key": "node scripts/generate-update-key.cjs",
    "updater:sign": "node scripts/sign-update-manifest.cjs",
    "state:backup": "node scripts/state-backup.cjs",
    "diagnostic": "node scripts/diagnostic-bundle.cjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "electron": "44.10.2",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "playwright": "1.63.0",
    "resedit": "3.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2",
    "yauzl": "^3.4.0"
  },
  "productName": "Lasmium TOKENS-HUB"
}
